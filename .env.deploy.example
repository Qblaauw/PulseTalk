# Copy this file to .env.deploy.local and fill only the values needed by the
# approved build host. Never commit .env.deploy.local.

RELEASE_REPOSITORY=Qblaauw/PulseTalq

# Tauri updater signing
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows DigiCert signing
SM_HOST=
SM_API_KEY=
SM_CLIENT_CERT_FILE=
SM_CLIENT_CERT_PASSWORD=
SM_CODE_SIGNING_CERT_SHA1_HASH=
DIGICERT_KEYPAIR_ALIAS=

# macOS signing and notarization
APPLE_ID=
APPLE_ID_PASSWORD=
APPLE_TEAM_ID=
APPLE_SIGNING_IDENTITY=
