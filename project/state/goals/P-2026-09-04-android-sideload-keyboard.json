{
  "contract": {
    "criteria": [
      {
        "id": "G1",
        "satisfied_by": [
          "T1",
          "T12",
          "T2",
          "T3"
        ],
        "text": "`assembleDebug` produces one installable APK and the handoff records its SHA-256."
      },
      {
        "id": "G2",
        "satisfied_by": [
          "T13"
        ],
        "text": "The APK installs on the Android 16 test handset without root access."
      },
      {
        "id": "G3",
        "satisfied_by": [
          "T11",
          "T13",
          "T7"
        ],
        "text": "The setup activity guides the tester through microphone permission, model installation, keyboard enablement, and keyboard selection."
      },
      {
        "id": "G4",
        "satisfied_by": [
          "T13",
          "T8"
        ],
        "text": "PulseTalq appears in Android's keyboard picker and basic tap typing works in another app."
      },
      {
        "id": "G5",
        "satisfied_by": [
          "T10",
          "T13",
          "T6",
          "T9"
        ],
        "text": "The tester records speech from the keyboard and the final local transcript appears at the current cursor in at least a messaging app and a notes app."
      },
      {
        "id": "G6",
        "satisfied_by": [
          "T13"
        ],
        "text": "Dictation still works in airplane mode after model installation."
      },
      {
        "id": "G7",
        "satisfied_by": [
          "T10",
          "T13",
          "T4"
        ],
        "text": "Cancelled dictation inserts nothing, and a failed insertion retains the transcript for retry or copy."
      },
      {
        "id": "G8",
        "satisfied_by": [
          "T10",
          "T13",
          "T9"
        ],
        "text": "Killing the ASR process does not crash the keyboard. The next voice attempt either reloads the model or shows a recoverable error."
      },
      {
        "id": "G9",
        "satisfied_by": [
          "T13",
          "T9"
        ],
        "text": "The test report records model load time, transcription latency, real-time factor, and peak memory on the handset."
      },
      {
        "id": "G10",
        "satisfied_by": [
          "T12",
          "T5",
          "T6"
        ],
        "text": "No GPL-derived source is present, and bundled notices cover the ASR model and native dependencies."
      }
    ],
